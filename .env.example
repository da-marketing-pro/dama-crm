# ==============================================================================
# DAMA CRM — ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ (.env.example)
# Скопируйте этот файл в .env и укажите ваши реальные значения:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. БАЗА ДАННЫХ (POSTGRESQL)
# ------------------------------------------------------------------------------
# Строка подключения Prisma к PostgreSQL
# Формат: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://crm_user:crm_password_secure_2026@localhost:5432/crm_db?schema=public"

# Параметры для развертывания через docker-compose
DB_USER=crm_user
DB_PASSWORD=crm_password_secure_2026
DB_NAME=crm_db

# ------------------------------------------------------------------------------
# 2. АВТОРИЗАЦИЯ И БЕЗОПАСНОСТЬ (NEXTAUTH)
# ------------------------------------------------------------------------------
# Публичный адрес CRM (в продакшене обязательно https:// вашего поддомена)
# Пример: https://crm.youragency.kz
NEXTAUTH_URL="http://localhost:3000"

# Секретный ключ для подписи JWT-токенов и сессий пользователей
# Сгенерируйте надежный ключ командой в терминале: openssl rand -base64 32
NEXTAUTH_SECRET="dama_nextauth_secret_key_change_in_production"

# Начальные данные администратора (создаются автоматически при первом запуске)
ADMIN_INITIAL_EMAIL="admin@crm.local"
ADMIN_INITIAL_PASSWORD="admin_secure_password_123"

# ------------------------------------------------------------------------------
# 3. АВТОМАТИЧЕСКИЙ КРОН (ОБНОВЛЕНИЕ КУРСОВ ВАЛЮТ)
# ------------------------------------------------------------------------------
# Секретный токен для защиты эндпоинта /api/cron/update-rates
# Используется внешней задачей (Cron/Coolify Scheduled Tasks) в заголовке Authorization:
# Authorization: Bearer dama_crm_cron_secret_token_secure_9921
CRON_SECRET="dama_crm_cron_secret_token_secure_9921"

# ------------------------------------------------------------------------------
# 4. ИНТЕГРАЦИЯ С WHATSAPP (EVOLUTION API V2)
# ------------------------------------------------------------------------------
# URL адрес сервиса Evolution API
# Внутри Docker: http://evolution-api:8080
# Внешний URL: http://localhost:8080 или https://api-wa.youragency.kz
EVOLUTION_API_URL="http://localhost:8080"

# Глобальный мастер API-ключ для авторизации в Evolution API v2
EVOLUTION_API_KEY="dama_evo_api_key_secret_2026"

# Имя инстанса WhatsApp по умолчанию в CRM
WHATSAPP_INSTANCE_NAME="dama-crm-wa"

# Порты для локального или VPS доступа через Docker Compose
CRM_PORT=3000
EVOLUTION_PORT=8080
